# Copy to .env.local for development. Never commit .env.local.
# On Vercel, set these under Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Public origin — used for canonical URLs, sitemap.xml, robots.txt and OG tags.
# Read at BUILD time, so it must be set before the build runs.
#
# Optional on Vercel: with this unset, the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL (your .vercel.app domain). Set it explicitly
# once you point a custom domain at the project, then redeploy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact form delivery. All optional; every configured transport is attempted.
# With none set, enquiries are written to the server log so nothing is lost.
# ---------------------------------------------------------------------------

# Transport 1 — email via Resend (https://resend.com, free tier available).
RESEND_API_KEY=
# Where enquiries are sent. Required for the Resend transport to run.
CONTACT_TO_EMAIL=
# Optional sender. Defaults to Resend's shared "onboarding@resend.dev" address,
# which works without verifying a domain. Replace once you verify your own.
CONTACT_FROM_EMAIL=

# Transport 2 — POST each enquiry as JSON. Slack and Teams incoming webhooks
# accept this payload unchanged.
CONTACT_WEBHOOK_URL=
